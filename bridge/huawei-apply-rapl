#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
# Apply RAPL PL1/PL2 limits matching the current Huawei turbo state.
set -u

STATUS=/run/huawei-turbo/status
PERF=${HUAWEI_PERF:-/usr/local/bin/huawei-perf}

# At boot the daemon may not have written the status file yet.
i=0
while [ ! -s "$STATUS" ] && [ "$i" -lt 20 ]; do
	sleep 0.5
	i=$((i + 1))
done

actual=$(python3 - "$STATUS" <<'PY'
import json
import sys

try:
    with open(sys.argv[1], encoding="utf-8") as handle:
        print(json.load(handle).get("actual", "unknown"))
except Exception:
    print("unknown")
PY
)

case "$actual" in
	on)
		# Vendor performance-mode pair.  The kernel may clamp PL2 to the
		# RAPL maximum (60.0 W on BoF-XX).
		exec "$PERF" rapl --pl1 31 --pl2 60.5 --apply
		;;
	off)
		exec "$PERF" rapl --pl1 20 --pl2 60.375 --apply
		;;
	*)
		exit 0
		;;
esac
